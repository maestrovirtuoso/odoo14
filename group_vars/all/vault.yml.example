---
# !!! SECRETS - a chiffrer avant tout commit :
#     ansible-vault encrypt group_vars/all/vault.yml
# et fournir --ask-vault-pass (ou --vault-password-file) aux commandes ansible.
# Remplacer ces valeurs par des mots de passe forts.
# Portee "all" et non "odoo_containers" : le conteneur PostgreSQL et les
# conteneurs Odoo doivent partager le meme vault_odoo_db_password, sinon
# l'authentification echoue en donnant l'illusion d'un bug de pg_hba.
vault_odoo_admin_password: "change-me-admin"
vault_odoo_db_password: "change-me-odoo-db"

# Role "replicator" : lit le flux WAL du primaire pour odoodb2 et odoodb3.
# Pose dans /var/lib/postgresql/.pgpass sur chaque reserve.
vault_pg_replication_password: "change-me-replication"

# Patroni (roles/ansi_postgresql_ha/pg_ha, playbooks/ansi_postgresql_ha.yaml). 12 caracteres
# minimum, differents des mots de passe ci-dessus (le role le verifie).
# Superutilisateur "postgres" : pg_rewind entre serveurs.
vault_pg_patroni_superuser_password: "change-me-patroni-superuser"
# Compte "patroni" de l'API REST : bascule, redemarrage, configuration.
vault_pg_patroni_rest_password: "change-me-patroni-rest"
