{
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": { "type": "grafana", "uid": "-- Grafana --" },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "description": "Disponibilité, latence, coût SQL, trafic et saturation des trois instances Odoo, et état du cluster PostgreSQL. Détail des panneaux et des requêtes : docs/grafana/RECAP-METRIQUES.md.",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [
    {
      "asDropdown": false,
      "icon": "external link",
      "includeVars": false,
      "keepTime": false,
      "tags": [],
      "targetBlank": true,
      "title": "Prometheus : cibles",
      "tooltip": "Status → Targets",
      "type": "link",
      "url": "http://192.168.36.164:9090/targets"
    }
  ],
  "panels": [
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "id": 100,
      "panels": [],
      "title": "Vue d'ensemble",
      "type": "row"
    },
    {
      "id": 1,
      "type": "stat",
      "title": "Service via nginx",
      "description": "Sonde /web/login à travers nginx, comme un utilisateur (§ 5.1). OK : page de connexion servie en 200, formulaire présent.",
      "datasource": { "type": "prometheus", "uid": "${ds}" },
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 1 },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "${ds}" },
          "editorMode": "code",
          "expr": "probe_success{job=\"odoo_login\", via=\"nginx\"}",
          "legendFormat": "{{instance}}",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "noValue": "pas de sonde",
          "color": { "mode": "thresholds" },
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": { "text": "PANNE", "color": "#d03b3b", "index": 0 },
                "1": { "text": "OK", "color": "#0ca30c", "index": 1 }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "#d03b3b", "value": null },
              { "color": "#0ca30c", "value": 1 }
            ]
          }
        },
        "overrides": [
          { "matcher": { "id": "byRegexp", "options": ".*guichetunique\\.cm.*" }, "properties": [ { "id": "displayName", "value": "nginx .cm" } ] },
          { "matcher": { "id": "byRegexp", "options": ".*guichetunique\\.org.*" }, "properties": [ { "id": "displayName", "value": "nginx .org" } ] }
        ]
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "orientation": "auto",
        "textMode": "value_and_name",
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "wideLayout": true,
        "showPercentChange": false
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Instances Odoo en service",
      "description": "Instances qui répondent en direct sur le port 8069 (§ 5.1). Moins de 3 : HA dégradée, même si nginx répond encore.",
      "datasource": { "type": "prometheus", "uid": "${ds}" },
      "gridPos": { "h": 4, "w": 4, "x": 6, "y": 1 },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "${ds}" },
          "editorMode": "code",
          "expr": "sum(probe_success{job=\"odoo_login\", via=\"direct\"})",
          "legendFormat": "en direct",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "suffix: / 3",
          "decimals": 0,
          "noValue": "pas de sonde",
          "color": { "mode": "thresholds" },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "#d03b3b", "value": null },
              { "color": "#fab219", "value": 2 },
              { "color": "#0ca30c", "value": 3 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "orientation": "auto",
        "textMode": "value",
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "wideLayout": true,
        "showPercentChange": false
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "PostgreSQL en marche",
      "description": "Serveurs dont PostgreSQL tourne, selon Patroni (patroni_postgres_running).",
      "datasource": { "type": "prometheus", "uid": "${ds}" },
      "gridPos": { "h": 4, "w": 4, "x": 10, "y": 1 },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "${ds}" },
          "editorMode": "code",
          "expr": "sum(patroni_postgres_running)",
          "legendFormat": "en marche",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "suffix: / 3",
          "decimals": 0,
          "noValue": "Patroni muet",
          "color": { "mode": "thresholds" },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "#d03b3b", "value": null },
              { "color": "#fab219", "value": 2 },
              { "color": "#0ca30c", "value": 3 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "orientation": "auto",
        "textMode": "value",
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "wideLayout": true,
        "showPercentChange": false
      }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Primaire PostgreSQL",
      "description": "Serveur qui détient le verrou de primaire Patroni. Les trois Odoo y écrivent, par HAProxy.",
      "datasource": { "type": "prometheus", "uid": "${ds}" },
      "gridPos": { "h": 4, "w": 4, "x": 14, "y": 1 },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "${ds}" },
          "editorMode": "code",
          "expr": "max by (instance) ((patroni_primary == 1) or (patroni_master == 1))",
          "legendFormat": "{{instance}}",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "noValue": "aucun",
          "color": { "mode": "thresholds" },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [ { "color": "#9085e9", "value": null } ]
          }
        },
        "overrides": [
          { "matcher": { "id": "byRegexp", "options": ".*192\\.168\\.33\\.161.*" }, "properties": [ { "id": "displayName", "value": "odoodb1" } ] },
          { "matcher": { "id": "byRegexp", "options": ".*192\\.168\\.33\\.162.*" }, "properties": [ { "id": "displayName", "value": "odoodb2" } ] },
          { "matcher": { "id": "byRegexp", "options": ".*192\\.168\\.33\\.163.*" }, "properties": [ { "id": "displayName", "value": "odoodb3" } ] }
        ]
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "orientation": "auto",
        "textMode": "name",
        "colorMode": "none",
        "graphMode": "none",
        "justifyMode": "auto",
        "wideLayout": true,
        "showPercentChange": false
      }
    },
    {
      "id": 5,
      "type": "stat",
      "title": "Réserves promouvables",
      "description": "Réserves dont le retard reste sous maximum_lag_on_failover (1 Mo) : Patroni ne promeut que celles-là. Moins de 2 : la HA de la base repose sur une seule réserve.",
      "datasource": { "type": "prometheus", "uid": "${ds}" },
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 1 },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "${ds}" },
          "editorMode": "code",
          "expr": "count(((scalar(max(patroni_xlog_location)) - patroni_xlog_replayed_location) < 1048576) and on (instance) (patroni_replica == 1)) or vector(0)",
          "legendFormat": "promouvables",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "suffix: / 2",
          "decimals": 0,
          "color": { "mode": "thresholds" },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "#d03b3b", "value": null },
              { "color": "#fab219", "value": 1 },
              { "color": "#0ca30c", "value": 2 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "orientation": "auto",
        "textMode": "value",
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "wideLayout": true,
        "showPercentChange": false
      }
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 5 },
      "id": 101,
      "panels": [],
      "title": "Disponibilité",
      "type": "row"
    },
    {
      "id": 6,
      "type": "state-timeline",
      "title": "Sondes HTTP par cible",
      "description": "Historique de chaque sonde /web/login (§ 5.1) : les deux noms nginx et les trois instances en direct.",
      "datasource": { "type": "prometheus", "uid": "${ds}" },
      "gridPos": { "h": 7, "w": 12, "x": 0, "y": 6 },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "${ds}" },
          "editorMode": "code",
          "expr": "probe_success{job=\"odoo_login\"}",
          "legendFormat": "{{instance}}",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "fillOpacity": 75,
            "lineWidth": 0,
            "hideFrom": { "legend": false, "tooltip": false, "viz": false }
          },
          "color": { "mode": "thresholds" },
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": { "text": "PANNE", "color": "#d03b3b", "index": 0 },
                "1": { "text": "OK", "color": "#0ca30c", "index": 1 }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "#d03b3b", "value": null },
              { "color": "#0ca30c", "value": 1 }
            ]
          }
        },
        "overrides": [
          { "matcher": { "id": "byRegexp", "options": ".*guichetunique\\.cm.*" }, "properties": [ { "id": "displayName", "value": "nginx .cm" } ] },
          { "matcher": { "id": "byRegexp", "options": ".*guichetunique\\.org.*" }, "properties": [ { "id": "displayName", "value": "nginx .org" } ] },
          { "matcher": { "id": "byRegexp", "options": ".*192\\.168\\.36\\.161.*" }, "properties": [ { "id": "displayName", "value": "odoo1" } ] },
          { "matcher": { "id": "byRegexp", "options": ".*192\\.168\\.36\\.162.*" }, "properties": [ { "id": "displayName", "value": "odoo2" } ] },
          { "matcher": { "id": "byRegexp", "options": ".*192\\.168\\.36\\.163.*" }, "properties": [ { "id": "displayName", "value": "odoo3" } ] }
        ]
      },
      "options": {
        "mergeValues": true,
        "showValue": "auto",
        "alignValue": "left",
        "rowHeight": 0.8,
        "legend": { "showLegend": true, "displayMode": "list", "placement": "bottom" },
        "tooltip": { "mode": "single", "sort": "none" }
      }
    },
    {
      "id": 7,
      "type": "state-timeline",
      "title": "Rôle des serveurs PostgreSQL",
      "description": "Primaire, réserve à jour, réserve en retard (1 Mo ou plus : Patroni ne la promeut pas) ou arrêté, selon Patroni. Quand le primaire change de ligne, il y a eu une bascule.",
      "datasource": { "type": "prometheus", "uid": "${ds}" },
      "gridPos": { "h": 7, "w": 12, "x": 12, "y": 6 },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "${ds}" },
          "editorMode": "code",
          "expr": "max by (instance) (((patroni_primary or patroni_master) * 2 + patroni_replica + 2 * patroni_replica * ((scalar(max(patroni_xlog_location)) - patroni_xlog_replayed_location) >= bool 1048576)) or (up{job=\"patroni\"} == 0))",
          "legendFormat": "{{instance}}",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "fillOpacity": 75,
            "lineWidth": 0,
            "hideFrom": { "legend": false, "tooltip": false, "viz": false }
          },
          "color": { "mode": "thresholds" },
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": { "text": "Arrêté", "color": "#d03b3b", "index": 0 },
                "1": { "text": "Réserve", "color": "#898781", "index": 1 },
                "2": { "text": "Primaire", "color": "#9085e9", "index": 2 },
                "3": { "text": "Réserve en retard", "color": "#fab219", "index": 3 }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [ { "color": "#d03b3b", "value": null } ]
          }
        },
        "overrides": [
          { "matcher": { "id": "byRegexp", "options": ".*192\\.168\\.33\\.161.*" }, "properties": [ { "id": "displayName", "value": "odoodb1" } ] },
          { "matcher": { "id": "byRegexp", "options": ".*192\\.168\\.33\\.162.*" }, "properties": [ { "id": "displayName", "value": "odoodb2" } ] },
          { "matcher": { "id": "byRegexp", "options": ".*192\\.168\\.33\\.163.*" }, "properties": [ { "id": "displayName", "value": "odoodb3" } ] }
        ]
      },
      "options": {
        "mergeValues": true,
        "showValue": "auto",
        "alignValue": "left",
        "rowHeight": 0.8,
        "legend": { "showLegend": true, "displayMode": "list", "placement": "bottom" },
        "tooltip": { "mode": "single", "sort": "none" }
      }
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 13 },
      "id": 102,
      "panels": [],
      "title": "Latence",
      "type": "row"
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Latence p95 (journal Odoo)",
      "description": "95 % des requêtes HTTP durent moins que cette valeur : temps SQL + Python, lu dans le journal (§ 5.2). N'inclut pas l'attente d'un worker libre.",
      "datasource": { "type": "prometheus", "uid": "${ds}" },
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 14 },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "${ds}" },
          "editorMode": "code",
          "expr": "histogram_quantile(0.95, sum by (instance, le) (rate(odoo_http_request_duration_seconds_bucket{job=\"odoo_logs\"}[5m])))",
          "legendFormat": "{{instance}}",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0,
          "color": { "mode": "palette-classic" },
          "custom": {
            "axisPlacement": "auto",
            "axisLabel": "",
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "lineWidth": 2,
            "fillOpacity": 0,
            "gradientMode": "none",
            "showPoints": "never",
            "pointSize": 5,
            "spanNulls": false,
            "scaleDistribution": { "type": "linear" },
            "stacking": { "group": "A", "mode": "none" },
            "hideFrom": { "legend": false, "tooltip": false, "viz": false },
            "thresholdsStyle": { "mode": "dashed" }
          },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "#0ca30c", "value": null },
              { "color": "#fab219", "value": 1 },
              { "color": "#d03b3b", "value": 3 }
            ]
          }
        },
        "overrides": [
          { "matcher": { "id": "byRegexp", "options": ".*192\\.168\\.36\\.161.*" }, "properties": [ { "id": "displayName", "value": "odoo1" }, { "id": "color", "value": { "mode": "fixed", "fixedColor": "#3987e5" } } ] },
          { "matcher": { "id": "byRegexp", "options": ".*192\\.168\\.36\\.162.*" }, "properties": [ { "id": "displayName", "value": "odoo2" }, { "id": "color", "value": { "mode": "fixed", "fixedColor": "#d95926" } } ] },
          { "matcher": { "id": "byRegexp", "options": ".*192\\.168\\.36\\.163.*" }, "properties": [ { "id": "displayName", "value": "odoo3" }, { "id": "color", "value": { "mode": "fixed", "fixedColor": "#199e70" } } ] }
        ]
      },
      "options": {
        "legend": { "showLegend": true, "displayMode": "list", "placement": "bottom", "calcs": ["lastNotNull"] },
        "tooltip": { "mode": "multi", "sort": "desc" }
      }
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Durée moyenne (journal Odoo)",
      "description": "Durée moyenne des requêtes HTTP, d'après le journal (§ 5.2).",
      "datasource": { "type": "prometheus", "uid": "${ds}" },
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 14 },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "${ds}" },
          "editorMode": "code",
          "expr": "sum by (instance) (rate(odoo_http_request_duration_seconds_sum[5m])) / sum by (instance) (rate(odoo_http_request_duration_seconds_count[5m]))",
          "legendFormat": "{{instance}}",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0,
          "color": { "mode": "palette-classic" },
          "custom": {
            "axisPlacement": "auto",
            "axisLabel": "",
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "lineWidth": 2,
            "fillOpacity": 0,
            "gradientMode": "none",
            "showPoints": "never",
            "pointSize": 5,
            "spanNulls": false,
            "scaleDistribution": { "type": "linear" },
            "stacking": { "group": "A", "mode": "none" },
            "hideFrom": { "legend": false, "tooltip": false, "viz": false },
            "thresholdsStyle": { "mode": "off" }
          },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [ { "color": "#0ca30c", "value": null } ]
          }
        },
        "overrides": [
          { "matcher": { "id": "byRegexp", "options": ".*192\\.168\\.36\\.161.*" }, "properties": [ { "id": "displayName", "value": "odoo1" }, { "id": "color", "value": { "mode": "fixed", "fixedColor": "#3987e5" } } ] },
          { "matcher": { "id": "byRegexp", "options": ".*192\\.168\\.36\\.162.*" }, "properties": [ { "id": "displayName", "value": "odoo2" }, { "id": "color", "value": { "mode": "fixed", "fixedColor": "#d95926" } } ] },
          { "matcher": { "id": "byRegexp", "options": ".*192\\.168\\.36\\.163.*" }, "properties": [ { "id": "displayName", "value": "odoo3" }, { "id": "color", "value": { "mode": "fixed", "fixedColor": "#199e70" } } ] }
        ]
      },
      "options": {
        "legend": { "showLegend": true, "displayMode": "list", "placement": "bottom", "calcs": ["lastNotNull"] },
        "tooltip": { "mode": "multi", "sort": "desc" }
      }
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Durée de la sonde /web/login",
      "description": "Temps de réponse vu de l'extérieur (§ 5.2). Sonde lente mais journal rapide : les workers sont saturés, les requêtes font la queue.",
