# ---------------------------------------------------------------------------
# Variables d'environnement du projet ProSys.
#
# Fichier MODELE, versionne : il ne doit contenir AUCUN secret.
# Usage :
#     cp .env.example .env
#     $EDITOR .env
#     set -a && source .env && set +a     # exporte tout avant ansible-playbook
#
# Ansible lit nativement les variables ANSIBLE_* ; elles remplacent les
# reglages de ansible.cfg. Les variables PROSYS_* sont propres au projet et
# se recuperent dans les playbooks avec :  lookup('env', 'PROSYS_...')
# ---------------------------------------------------------------------------

# --- Ansible : configuration generale -------------------------------------
# Fichier de config a utiliser (utile si on lance ansible hors du depot).
ANSIBLE_CONFIG=./ansible.cfg

# Inventaire par defaut (deja fixe par ansible.cfg, redondant mais explicite).
ANSIBLE_INVENTORY=./inventory.yaml

# Les conteneurs sont recrees regulierement : leur cle d'hote change a chaque
# fois. On desactive donc la verification (l'inventaire fait deja de meme).
ANSIBLE_HOST_KEY_CHECKING=False

# Accelere l'execution : une seule connexion SSH par tache au lieu d'une par
# module. Necessite requiretty desactive cote cible (c'est le cas sur Debian).
ANSIBLE_PIPELINING=True

# Nombre d'hotes traites en parallele (4 hotes + 4 conteneurs ici).
ANSIBLE_FORKS=8

# Sortie plus lisible que le format par defaut. Le callback "yaml" est fourni
# par la collection community.general (deja dans requirements.yml).
# ANSIBLE_STDOUT_CALLBACK=community.general.yaml

# Journal d'execution. Laisser vide pour ne rien ecrire.
# ANSIBLE_LOG_PATH=./ansible.log

# --- Ansible : vault -------------------------------------------------------
# Chemin d'un fichier contenant le mot de passe du vault, en clair.
# S'il est renseigne, --ask-vault-pass devient inutile.
# A placer HORS du depot et en chmod 600 :
#     printf '%s' 'mon-mot-de-passe' > ~/.prosys-vault-pass && chmod 600 ~/.prosys-vault-pass
# ANSIBLE_VAULT_PASSWORD_FILE=~/.prosys-vault-pass

# --- Ansible : SSH ---------------------------------------------------------
# Cle privee utilisee pour joindre les hotes et les conteneurs. Ces derniers
# sont desormais sur le LAN par carte physique dediee : plus aucun rebond.
# ANSIBLE_PRIVATE_KEY_FILE=~/.ssh/id_rsa

# --- Projet : surcharges ProSys -------------------------------------------
# Cle publique injectee dans les conteneurs par le role lxc_lan.
# Par defaut le role lit ~/.ssh/id_rsa.pub ; a renseigner si la cle est ailleurs.
# PROSYS_CONTROLLER_SSH_PUBKEY="ssh-ed25519 AAAA..."

# Version d'Odoo deployee (depot nightly).
PROSYS_ODOO_VERSION=14.0

# Base PostgreSQL UNIQUE, partagee par toutes les instances Odoo et servie
# par le primaire PostgreSQL declare dans db_primary (192.168.96.156).
# Laisser vide/commente = on garde la valeur de group_vars/all/vars.yml.
PROSYS_ODOO_DB=prod

# PROSYS_ODOO_WEB_PORT a disparu : les conteneurs sont exposes directement sur
# le LAN par une carte physique, il n'y a plus de redirection de port depuis
# l'hote. Odoo ecoute sur le 8069 de sa propre IP (.151, .152, .153).
