# {{ ansible_managed }}
#
# Porte la VIP {{ lb_vip }} sur le noeud vivant de plus haute priorite, et la
# fait basculer si cet hote -- ou son HAProxy -- disparait.

global_defs {
    router_id {{ inventory_hostname }}
    script_user root
    enable_script_security
}

# La VIP ne doit pas rester sur un hote dont HAProxy est mort : elle y
# recevrait du trafic que personne ne sert. Ce test fait chuter la priorite
# et declenche la bascule.
vrrp_script chk_haproxy {
    script "/usr/bin/pgrep -x haproxy"
    interval 2
    fall 2
    rise 2
}

vrrp_instance VI_ODOO {
    # BACKUP partout, et non MASTER sur un noeud : la priorite seule decide.
    # Un etat MASTER declare ferait reprendre la VIP au demarrage avant meme
    # que HAProxy soit pret.
    state BACKUP
    interface {{ ansible_default_ipv4.interface }}
    virtual_router_id {{ lb_vrrp_id }}
    priority {{ lb_vrrp_priorite_max - (groups['lb_hosts'].index(inventory_hostname) * lb_vrrp_pas) }}
    advert_int 1

    # Unicast et non multicast : plus fiable sur un reseau virtualise, ou le
    # multicast est souvent filtre par l'hyperviseur sans que rien ne le dise.
    unicast_src_ip {{ ansible_default_ipv4.address }}
    unicast_peer {
{% for h in groups['lb_hosts'] if h != inventory_hostname %}
        {{ hostvars[h].ansible_default_ipv4.address | default(h) }}
{% endfor %}
    }

    authentication {
        auth_type PASS
        auth_pass {{ lb_vrrp_motdepasse }}
    }

    virtual_ipaddress {
        {{ lb_vip }}/{{ lb_vip_prefixe }}
    }

    track_script {
        chk_haproxy
    }
}
