# {{ ansible_managed }}
#
# Membre etcd {{ inventory_hostname }} du cluster de Patroni ({{ pg_ha_scope }}).
# Lu par l'unite etcd.service du paquet Debian (EnvironmentFile) : chaque
# variable ETCD_X correspond a l'option --x d'etcd.

ETCD_NAME="{{ inventory_hostname }}"
# Repertoire DEDIE, et non /var/lib/etcd/default : un etcd demarre un jour
# par le paquet y aurait laisse un cluster a un membre, qui refuserait de
# rejoindre celui-ci.
ETCD_DATA_DIR="{{ pg_ha_etcd_data_dir }}"

# Entre membres (2380) et pour les clients (2379). La boucle locale sert a
# etcdctl sur le serveur lui-meme.
ETCD_LISTEN_PEER_URLS="https://{{ ansible_host }}:{{ pg_ha_etcd_peer_port }}"
ETCD_INITIAL_ADVERTISE_PEER_URLS="https://{{ ansible_host }}:{{ pg_ha_etcd_peer_port }}"
ETCD_LISTEN_CLIENT_URLS="https://{{ ansible_host }}:{{ pg_ha_etcd_client_port }},https://127.0.0.1:{{ pg_ha_etcd_client_port }}"
ETCD_ADVERTISE_CLIENT_URLS="https://{{ ansible_host }}:{{ pg_ha_etcd_client_port }}"

# Composition initiale, derivee de l'inventaire. N'est lue qu'a la creation
# du cluster : une fois le repertoire de donnees initialise, etcd l'ignore.
ETCD_INITIAL_CLUSTER="{% for h in pg_ha_nodes %}{{ h }}=https://{{ hostvars[h].ansible_host }}:{{ pg_ha_etcd_peer_port }}{{ '' if loop.last else ',' }}{% endfor %}"
ETCD_INITIAL_CLUSTER_STATE="new"
ETCD_INITIAL_CLUSTER_TOKEN="{{ pg_ha_scope }}"

# TLS des clients : certificat EXIGE, signe par l'autorite d'etcd.
ETCD_CERT_FILE="{{ pg_ha_etcd_ssl_dir }}/server.crt"
ETCD_KEY_FILE="{{ pg_ha_etcd_ssl_dir }}/server.key"
ETCD_TRUSTED_CA_FILE="{{ pg_ha_etcd_ssl_dir }}/ca.crt"
ETCD_CLIENT_CERT_AUTH="true"

# TLS entre membres : meme exigence.
ETCD_PEER_CERT_FILE="{{ pg_ha_etcd_ssl_dir }}/server.crt"
ETCD_PEER_KEY_FILE="{{ pg_ha_etcd_ssl_dir }}/server.key"
ETCD_PEER_TRUSTED_CA_FILE="{{ pg_ha_etcd_ssl_dir }}/ca.crt"
ETCD_PEER_CLIENT_CERT_AUTH="true"
