# {{ ansible_managed }}
[options]
admin_passwd = {{ odoo_admin_password }}

# Base PostgreSQL PARTAGEE, servie par le conteneur db_containers.
# Ce bloc valait auparavant "db_host = False / db_port = False", c'est-a-dire
# la socket Unix locale : c'est ici que se joue la bascule vers le serveur
# dedie. Il n'y a plus de serveur PostgreSQL dans ce conteneur.
db_host = {{ odoo_db_host }}
db_port = {{ odoo_db_port }}
db_user = {{ odoo_db_user }}
db_password = {{ odoo_db_password }}

# Nombre de connexions ouvertes par CETTE instance. A tenir coherent avec
# max_connections du serveur : plusieurs instances x plusieurs workers x
# db_maxconn se cumulent, et le depassement donne des "too many clients"
# intermittents sous charge, pas une panne franche.
db_maxconn = {{ odoo_db_maxconn }}

# Instance mono-base. db_name est INDISPENSABLE avec list_db = False :
# sans lui Odoo ne peut ni lister ni deduire la base a servir, et repond 500.
db_name = {{ odoo_shared_db }}
dbfilter = ^{{ odoo_shared_db }}$
list_db = False

addons_path = {{ odoo_addons_path }}

# data_dir reste LOCAL a chaque noeud, mais son sous-repertoire filestore ne
# l'est plus : c'est le point de montage du volume GlusterFS replica 3, bind-
# monte depuis l'hote par le role odoo_filestore. Les pieces jointes sont donc
# sur disque et communes aux trois instances (ir_attachment.location = file,
# pose par le role odoo_dbinit).
#
# Ce qui reste local : data_dir/sessions. Sans repartiteur de charge chaque
# utilisateur vise une IP fixe, ce qui est coherent, et GlusterFS est mauvais
# sur les tres nombreux petits fichiers a forte rotation que sont les
# sessions. Le jour ou un HAProxy est place devant, il faudra des sessions
# collantes, ou etendre le partage aux sessions en acceptant le cout.
data_dir = {{ odoo_data_dir }}

logfile = {{ odoo_log_path }}
log_level = info
proxy_mode = True
workers = {{ odoo_workers }}

# Taches planifiees : actives sur le SEUL noeud primaire (groupe
# odoo_primary), a 0 partout ailleurs. Plusieurs ordonnanceurs sur une base
# partagee se disputent les memes verrous sans rien apporter.
max_cron_threads = {{ odoo_max_cron_threads }}
