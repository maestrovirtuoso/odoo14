# {{ ansible_managed }}
# Parametres de replication streaming - inclus via conf.d/
listen_addresses = '*'
password_encryption = scram-sha-256
wal_level = replica
max_wal_senders = {{ pg_max_wal_senders }}
max_replication_slots = {{ pg_max_wal_senders }}
wal_keep_size = {{ pg_wal_keep_size }}
hot_standby = on
hot_standby_feedback = on
