#!/bin/bash
# {{ ansible_managed }}
# Pousse le filestore Odoo du primaire vers chaque standby.
set -u
SRC="{{ odoo_filestore }}/"
SSH_OPTS="-o BatchMode=yes -o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null -o ConnectTimeout=5"
RC=0

for target in {{ standby_ips | join(' ') }}; do
  rsync -a --delete --chown={{ odoo_system_user }}:{{ odoo_system_user }} \
    -e "ssh ${SSH_OPTS}" \
    "${SRC}" "root@${target}:{{ odoo_filestore }}/" || RC=$?
done

exit $RC
